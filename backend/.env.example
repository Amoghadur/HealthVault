PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
CONTRACT_ADDRESS=deployed-healthvault-contract-address
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECORD_ENCRYPTION_KEY=64-character-hex-key
# Master key for wrapping per-record encryption keys at rest (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECORD_KEY_ENCRYPTION_SECRET=your-64-character-hex-master-key
# Pinata API JWT with permission to pin files
PINATA_JWT=your-pinata-jwt
# Allowed CORS origins (comma-separated, defaults to http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public HTTPS URL for Emergency QR cross-device scanning (e.g. Cloudflare Tunnel or public HTTPS domain)
# Required for cross-device mobile scanning. Must be absolute HTTPS; localhost and private LAN IPs are rejected.
EMERGENCY_QR_BASE_URL=https://your-public-tunnel.trycloudflare.com
